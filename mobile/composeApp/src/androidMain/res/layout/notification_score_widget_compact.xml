<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="0dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/score_widget_compact_away_logo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
                android:scaleType="centerInside" />

        <TextView
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/score_widget_compact_away_team"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/score_widget_text"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="LG" />
    </LinearLayout>

    <TextView
        android:id="@+id/score_widget_compact_away_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/score_widget_text"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="3" />

    <TextView
        android:id="@+id/score_widget_compact_score_separator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="6dp"
        android:text=":"
        android:textColor="@color/score_widget_detail"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/score_widget_compact_home_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/score_widget_text"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="2" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/score_widget_compact_home_team"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/score_widget_text"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="두산" />

        <TextView
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <ImageView
            android:id="@+id/score_widget_compact_home_logo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
                android:scaleType="centerInside" />
    </LinearLayout>

    <TextView
        android:id="@+id/score_widget_compact_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_score_widget_status"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp"
        android:textColor="@color/score_widget_status"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="경기종료" />
</LinearLayout>
